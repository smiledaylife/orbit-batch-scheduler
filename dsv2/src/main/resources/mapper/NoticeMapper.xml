<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.natpcp.natpcp.dsv2.dao.mapper.NoticeMapper">

    <resultMap id="noticePOMap" type="com.natpcp.natpcp.dsv2.dao.po.NoticePO">
            <result property="id" column="id" jdbcType="VARCHAR"/>
            <result property="title" column="title" jdbcType="VARCHAR"/>
            <result property="content" column="content" jdbcType="VARCHAR"/>
            <result property="receiveTellerNo" column="receive_teller_no" jdbcType="VARCHAR"/>
            <result property="status" column="status" jdbcType="VARCHAR"/>
            <result property="businessId" column="business_id" jdbcType="VARCHAR"/>
            <result property="createTellerNo" column="create_teller_no" jdbcType="VARCHAR"/>
            <result property="createTime" column="create_time" jdbcType="TIMESTAMP"/>
            <result property="lastModTellerNo" column="last_mod_teller_no" jdbcType="VARCHAR"/>
            <result property="lastModTime" column="last_mod_time" jdbcType="TIMESTAMP"/>
            <result property="tellerName" column="teller_name" jdbcType="VARCHAR"/>
            <result property="receiveRole" column="receive_role" jdbcType="VARCHAR"/>
    </resultMap>

    <sql id="notice_Column_List">
        id,title,content,
        receive_teller_no,status,business_id,
        create_teller_no,create_time,last_mod_teller_no,
        last_mod_time,receive_role
    </sql>

    <!-- 主键 id 由应用侧生成 UUID，不使用数据库自增 -->
    <insert id="insert" parameterType="com.natpcp.natpcp.dsv2.dao.po.NoticePO">
        insert into tb_pmctl_auth_notice
        ( id,title,content
        ,receive_teller_no,status,business_id
        ,create_teller_no,create_time,last_mod_teller_no
        ,last_mod_time,receive_role )
        values (#{id,jdbcType=VARCHAR},#{title,jdbcType=VARCHAR},#{content,jdbcType=VARCHAR}
        ,#{receiveTellerNo,jdbcType=VARCHAR},#{status,jdbcType=BIT},#{businessId,jdbcType=VARCHAR}
        ,#{createTellerNo,jdbcType=VARCHAR},#{createTime,jdbcType=TIMESTAMP},#{lastModTellerNo,jdbcType=VARCHAR}
        ,#{lastModTime,jdbcType=TIMESTAMP},#{receiveRole ,jdbcType=VARCHAR})
    </insert>

    <delete id="clearNotice" >
        delete from tb_pmctl_auth_notice where create_time <![CDATA[ <= ]]> #{localDate}
    </delete>

</mapper>
