<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.natpcp.natpcp.dsv2.dao.mapper.ConfigurationVersionServiceMapper">

    <resultMap id="BaseResultMap" type="com.natpcp.natpcp.dsv2.dao.po.ConfigurationVersionPo">
        <result property="configName" column="config_name" jdbcType="VARCHAR"/>
        <result property="version" column="version" jdbcType="VARCHAR"/>

    </resultMap>


    <insert id="insert"  parameterType="com.natpcp.natpcp.dsv2.dao.po.ConfigurationVersionPo">
        insert into tb_configuration_version
            ( config_name,version)
        values
            (#{configName,jdbcType=VARCHAR},#{version,jdbcType=VARCHAR})
    </insert>

    <select id="select" resultMap="BaseResultMap">
        select * from tb_configuration_version where config_name=#{configName}
    </select>

    <select id="selectAll"
            resultType="com.natpcp.natpcp.dsv2.dao.dto.ConfigurationVersionDTO">
             select config_name configType,version from tb_configuration_version
    </select>
    <select id="selectByConfigName" resultType="java.util.HashMap">
        select config_name,version from tb_configuration_version where config_name like '%forward%' or config_name = 'ng_forward_obj'
    </select>

    <update id="update"  >
        <if test="version != null and version !='' and configName  != null and configName !='' ">
            update  tb_configuration_version
            set version=#{version}
            where config_name=#{configName}
        </if>
    </update>

    <delete id="delete">
        delete from tb_configuration_version where config_name=#{configName}
    </delete>


</mapper>
