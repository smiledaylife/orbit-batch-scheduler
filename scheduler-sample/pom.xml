<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.orbit</groupId>
        <artifactId>orbit-batch-scheduler</artifactId>
        <version>1.0.0</version>
    </parent>

    <artifactId>scheduler-sample</artifactId>
    <name>Orbit Scheduler :: Sample</name>
    <description>开箱演示应用：standalone / local(H2) / postgresql / gaussdb / mysql 五套运行模式</description>

    <dependencies>
        <dependency>
            <groupId>com.orbit</groupId>
            <artifactId>scheduler-starter</artifactId>
            <version>${project.version}</version>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>

        <!-- postgresql profile：PG 10+ 驱动（Boot BOM 管理，此处覆盖为 42.7.3） -->
        <dependency>
            <groupId>org.postgresql</groupId>
            <artifactId>postgresql</artifactId>
            <scope>runtime</scope>
        </dependency>

        <!-- gaussdb profile：openGauss/GaussDB 驱动（与 PG 驱动共存，
             由 spring.datasource.driver-class-name 决定实际加载） -->
        <dependency>
            <groupId>org.opengauss</groupId>
            <artifactId>opengauss-jdbc</artifactId>
            <scope>runtime</scope>
        </dependency>

        <!-- mysql profile -->
        <dependency>
            <groupId>com.mysql</groupId>
            <artifactId>mysql-connector-j</artifactId>
            <scope>runtime</scope>
        </dependency>

        <!-- local profile：H2 内存库演示 -->
        <dependency>
            <groupId>com.h2database</groupId>
            <artifactId>h2</artifactId>
            <scope>runtime</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
        </plugins>
    </build>
</project>
