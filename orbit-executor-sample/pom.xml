<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <!-- 继承根 POM：依赖版本、编译级别与插件配置全部由父 POM 统一管理 -->
    <parent>
        <groupId>com.orbit</groupId>
        <artifactId>orbit-batch-scheduler</artifactId>
        <version>1.0.0</version>
    </parent>

    <artifactId>orbit-executor-sample</artifactId>
    <packaging>jar</packaging>
    <name>Orbit :: Executor Sample</name>
    <description>执行器示例：业务服务接入 orbit-executor</description>

    <dependencies>
        <dependency>
            <groupId>com.orbit</groupId>
            <artifactId>orbit-executor</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>

        <!--
          引入 Redis（第 1 步）：取消本段注释。
          orbit-executor 将 Redis 依赖声明为 optional（不传递给业务应用），
          需要跨副本幂等 / Redis Stream 持久化回传时必须由业务侧显式引入，
          再完成 application.yml 中的第 2、3 步（连接配置 + 开关）。
        -->
        <!--
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-redis</artifactId>
        </dependency>
        -->
    </dependencies>

    <build>
        <plugins>
            <!-- 版本与 repackage 执行由父 POM pluginManagement 下发，这里只需声明启用 -->
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
        </plugins>
    </build>

</project>
