<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <!-- 继承根 POM：编译级别、插件配置与版本管理全部由父 POM 统一下发 -->
    <parent>
        <groupId>com.orbit</groupId>
        <artifactId>orbit-batch-scheduler</artifactId>
        <version>1.0.0</version>
    </parent>

    <artifactId>orbit-core</artifactId>
    <packaging>jar</packaging>
    <name>Orbit :: Core</name>
    <description>调度中心与执行器共享协议、模型</description>

    <!--
      无第三方依赖：本模块只有纯 POJO 协议模型，序列化由使用方（admin/executor 的 Spring MVC + Jackson）完成。
      不声明 jackson-annotations：本模块没有任何 com.fasterxml 引用，
      避免把 Jackson 作为传递依赖强加给业务方。

      字节码基线与全项目统一为 JDK 21（父 POM java.release）：项目为新项目、无老 JRE 兼容诉求，
      统一基线后协议层与两端可用同一套语言特性（record / switch 模式匹配等），
      构建、调试与依赖分析也不再需要跨版本工具链。
    -->

</project>
