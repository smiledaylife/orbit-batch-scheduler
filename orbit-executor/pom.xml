<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <!-- 继承根 POM：依赖版本、编译级别、enforcer 与插件配置全部由父 POM 统一管理 -->
    <parent>
        <groupId>com.orbit</groupId>
        <artifactId>orbit-batch-scheduler</artifactId>
        <version>1.0.0</version>
    </parent>

    <artifactId>orbit-executor</artifactId>
    <packaging>jar</packaging>
    <name>Orbit :: Executor</name>
    <description>执行器 SDK：@OrbitJob 扫描、向调度中心注册、接收触发执行</description>

    <!--
      执行器 SDK 与调度中心同基线 JDK 21 / Spring Boot 3.5（父 POM 统一下发）。
      依赖 SDK 的业务应用也必须运行在 JDK 21+ / Spring Boot 3.5.x。
    -->
    <dependencies>
        <dependency>
            <groupId>com.orbit</groupId>
            <artifactId>orbit-core</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework</groupId>
            <artifactId>spring-web</artifactId>
        </dependency>
        <!--
            Redis 仅在两类可选能力中使用：logId 执行幂等（默认关闭）与持久化 callback（默认关闭）。
            optional=true：业务应用不传递继承该依赖 —— 未使用 Redis 的应用不引入 Redis 客户端 jar，
            也不会激活 Spring Boot 的 RedisAutoConfiguration / RedisHealthIndicator
            （否则 actuator 健康探针会因连不上 Redis 误报 DOWN）。
            自动装配对两类能力都做了无 Redis 降级，见 OrbitExecutorAutoConfiguration。
        -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-redis</artifactId>
            <optional>true</optional>
        </dependency>
        <!--
          Caffeine 单节点缓存：执行幂等的 JVM 本地兜底实现（logId 去重）。
          expireAfterWrite 提供 TTL、maximumSize 提供容量淘汰，
          替代手工清扫的 ConcurrentHashMap；版本由 spring-boot-dependencies BOM 托管。
        -->
        <dependency>
            <groupId>com.github.ben-manes.caffeine</groupId>
            <artifactId>caffeine</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-configuration-processor</artifactId>
            <optional>true</optional>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <!-- 纯库模块：不打包可执行 jar，无需 spring-boot-maven-plugin -->
</project>
