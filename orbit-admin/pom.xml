<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>com.orbit</groupId>
        <artifactId>orbit-batch-scheduler</artifactId>
        <version>1.0.0</version>
    </parent>
    <artifactId>orbit-admin</artifactId>
    <name>Orbit :: Admin (调度中心)</name>
    <description>调度中心：任务管理、Cron 触发、执行器注册、HTTP 派发</description>

    <properties>
        <!-- 调度中心依赖 Quartz 2.5.x（class 版本 55），编译与运行均需 JDK 11+。
             覆盖根 POM 的 1.8 设置；reactor 整体须使用 JDK 11+ 构建。 -->
        <orbit.java.release>11</orbit.java.release>
        <java.version>11</java.version>
    </properties>

    <dependencies>
        <dependency>
            <groupId>com.orbit</groupId>
            <artifactId>orbit-core</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>
        <!-- MyBatis-Plus（传递引入 mybatis、mybatis-spring、spring-boot-starter-jdbc） -->
        <dependency>
            <groupId>com.baomidou</groupId>
            <artifactId>mybatis-plus-boot-starter</artifactId>
        </dependency>
        <!-- Druid 数据库连接池 -->
        <dependency>
            <groupId>com.alibaba</groupId>
            <artifactId>druid-spring-boot-starter</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-quartz</artifactId>
        </dependency>
        <!--
          Quartz 2.5.x 的连接池依赖（c3p0 / HikariCP）在其自身 POM 中为 provided 作用域。
          当前使用内存 JobStore（spring.quartz.job-store-type=memory），无需连接池；
          若日后切换为 JDBC JobStore（Quartz 集群），需显式引入 com.mchange:c3p0 或 com.zaxxer:HikariCP。
          slf4j-api 由 spring-boot-starter-logging 提供，满足 Quartz 2.5 的 slf4j-api(runtime) 要求。
        -->

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>
        <dependency>
            <groupId>com.h2database</groupId>
            <artifactId>h2</artifactId>
            <scope>runtime</scope>
        </dependency>
        <dependency>
            <groupId>org.postgresql</groupId>
            <artifactId>postgresql</artifactId>
            <scope>runtime</scope>
        </dependency>
        <dependency>
            <groupId>org.opengauss</groupId>
            <artifactId>opengauss-jdbc</artifactId>
            <version>5.0.1</version>
            <scope>runtime</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
        <!-- MyBatis-Plus 测试切片（@MybatisPlusTest，自动配置 H2 + 回滚） -->
        <dependency>
            <groupId>com.baomidou</groupId>
            <artifactId>mybatis-plus-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <!-- 调度中心依赖 Quartz 2.5.x（class 文件版本 55），JDK 8 无法编译/运行。
                 提前失败并给出可读提示，避免出现 "invalid target release: 11" 之类的晦涩报错。 -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-enforcer-plugin</artifactId>
                <version>3.4.1</version>
                <executions>
                    <execution>
                        <id>enforce-jdk11-for-admin</id>
                        <goals>
                            <goal>enforce</goal>
                        </goals>
                        <configuration>
                            <rules>
                                <requireJavaVersion>
                                    <version>[11,)</version>
                                    <message>orbit-admin（调度中心）依赖 Quartz 2.5.x，必须使用 JDK 11 及以上构建。
请将 JAVA_HOME 指向 JDK 11+ 后重试；若只需构建 Java 8 的 SDK 模块，可执行：
  mvn clean package -DskipTests -pl orbit-core,orbit-executor,orbit-executor-sample</message>
                                </requireJavaVersion>
                            </rules>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
        </plugins>
    </build>
</project>
